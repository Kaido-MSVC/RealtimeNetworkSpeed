#include "version.h"
#include <windows.h>
IDI_ICON1 ICON "app.ico"
1 VERSIONINFO
 FILEVERSION APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileVersion", APP_VERSION "\0"
   VALUE "ProductVersion", APP_VERSION "\0"
   VALUE "ProductName", "RealtimeNetworkSpeed\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
